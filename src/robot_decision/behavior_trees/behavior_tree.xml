<root main_tree_to_execute="MainTree" BTCPP_format="4">
  <BehaviorTree ID="MainTree">
    <Sequence>
      <!-- 持续检查直到条件满足 -->
      <RetryUntilSuccessful num_attempts="-1">  <!-- -1表示无限重试 -->
        <IfGameStart name="IfGameStart"/>
      </RetryUntilSuccessful>
      
      <Repeat num_cycles="-1">
        <Fallback>
          <Sequence>
            <IfHealth name = "IfHealth"/> <!-- 检查生命值 -->
            <RetryUntilSuccessful num_attempts="20">  <!-- -1表示无限重试 -->
              <NavigateToPose goal="3.0;0.45;0.0"/>  <!-- 如果健康，前增益点交战 -->
            </RetryUntilSuccessful>
          </Sequence>
          <Sequence>
            <IfHealth name = "IfHealth"/> <!-- 检查生命值,以及防止消息为空 -->
            <RetryUntilSuccessful num_attempts="20">  <!-- -1表示无限重试 -->
              <NavigateToPose goal="3.0;0.45;0.0"/>  <!-- 如果不健康，回家补血 -->
            </RetryUntilSuccessful>
          </Sequence>
        </Fallback>
      </Repeat>
    </Sequence>
  </BehaviorTree>
</root>