<root main_tree_to_execute="MainTree" BTCPP_format="4">
  <BehaviorTree ID="MainTree">
    <Sequence>
      <!-- 持续检查直到条件满足 -->
      <RetryUntilSuccessful num_attempts="-1">  <!-- -1表示无限重试 -->
        <IfGameStart name="IfGameStart"/>
      </RetryUntilSuccessful>
      
      <Repeat num_cycles="-1">
        <ForceSuccess>
          <Fallback>
            <Sequence>
              <IfHealth name = "IfHealth" message="checkhealth" /> <!-- 检查生命值 -->
              <RetryUntilSuccessful num_attempts="20">  <!-- -1表示无限重试 -->
                <NavigateToPose goal="3.0;0.45;0.0"/>  <!-- 如果健康，前增益点交战 -->
              </RetryUntilSuccessful>
            </Sequence>
            <Sequence>
              <IfHealth name = "IfHealth" message="checkunhealth" /> <!-- 检查生命值,以及防止消息为空(有问题) -->
              <RetryUntilSuccessful num_attempts="20">  <!-- -1表示无限重试 -->
                <NavigateToPose goal="2.0;0.45;0.0"/>  <!-- 如果不健康，回家补血 -->
              </RetryUntilSuccessful>
            </Sequence>
          </Fallback>
        </ForceSuccess> <!-- 如果都失败返回failure，repeat会退出 -->
      </Repeat>
    </Sequence>
  </BehaviorTree>
</root>